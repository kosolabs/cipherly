{
  "name": "cipherly",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit -- --run && pnpm test:e2e",
    "test:ci": "pnpm run \"/^(build|check|lint|test:unit)$/\""
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">= 20"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lucide/svelte": "1.66.0",
    "@msgpack/msgpack": "3.1.3",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/eslint": "9.6.1",
    "@types/node": "26.6.6",
    "autoprefixer": "10.6.2",
    "clsx": "2.1.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "filesize": "11.0.29",
    "globals": "17.13.0",
    "google-oauth-gsi": "4.0.1",
    "js-base64": "3.9.5",
    "jsdom": "30.1.3",
    "jwt-decode": "4.0.0",
    "kosui": "0.1.1",
    "mode-watcher": "1.1.0",
    "postcss": "8.5.32",
    "postcss-load-config": "6.0.1",
    "prettier": "3.9.10",
    "prettier-plugin-jsdoc": "1.8.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "4.0.1",
    "tailwindcss": "4.3.3",
    "tslib": "2.9.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "pnpm": {
    "overrides": {
      "cookie": "2.0.1"
    },
    "onlyBuiltDependencies": [
      "@sveltejs/kit",
      "@tailwindcss/oxide",
      "esbuild"
    ]
  }
}
